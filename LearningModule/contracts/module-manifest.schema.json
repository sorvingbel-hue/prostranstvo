{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Learning module concept manifest",
  "type": "object", "additionalProperties": false,
  "required": ["module_id", "module_version", "contract_version", "stage", "runtime_available", "host_required", "capabilities"],
  "properties": {
    "module_id": {"const": "prostranstvo.learning"},
    "module_version": {"const": "0.0.0-concept"},
    "contract_version": {"const": "1.0-draft"},
    "stage": {"const": "concept_only"},
    "runtime_available": {"const": false},
    "host_required": {"const": false},
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "scope"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{1,80}$"},
          "state": {"const": "planned"},
          "scope": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
