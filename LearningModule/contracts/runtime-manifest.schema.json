{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Learning module prototype manifest",
  "type": "object", "additionalProperties": false,
  "required": ["module_id", "module_version", "contract_version", "stage", "runtime_available", "host_required", "active_host_connected", "capabilities", "limitations"],
  "properties": {
    "module_id": {"const": "prostranstvo.learning"},
    "module_version": {"const": "0.1.0"},
    "contract_version": {"const": "1.0"},
    "stage": {"const": "local_prototype"},
    "runtime_available": {"const": true},
    "host_required": {"const": false},
    "active_host_connected": {"const": false},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "state", "scope"],
      "properties": {"id": {"type": "string"}, "state": {"enum": ["planned", "implemented", "verified"]}, "scope": {"type": "string", "minLength": 1}, "evidence": {"type": "string"}},
      "allOf": [{"if": {"properties": {"state": {"const": "verified"}}}, "then": {"required": ["evidence"]}}]
    }},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string"}}
  }
}
